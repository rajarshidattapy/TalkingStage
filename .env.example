# Live voice director (WebRTC Realtime session + primary transcription).
OPENAI_API_KEY=

# Generated slide backgrounds, and topic-tag extraction on the setup screen.
GEMINI_API_KEY=

# Fallback speech-to-text (saaras:v3-realtime) used when OpenAI's transcription
# is empty or does not arrive for a turn, and PDF notes -> Markdown via
# Sarvam Document AI. Without it the app keeps whatever OpenAI returned and
# PDF upload is disabled.
SARVAM_API_KEY=

# Web research on the setup screen: scrapes stock photo search pages for topic
# imagery and Wikipedia articles for background. Without it the setup screen
# still works, minus the "Research topics" button.
ANAKIN_API_KEY=

# Optional. Overrides for local development.
# ANAKIN_BASE_URL=https://api.anakin.io
# GURUDORNAAI_DATA_DIR=./data
